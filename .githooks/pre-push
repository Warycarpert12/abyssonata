#!/bin/sh
# Перед отправкой: файлы и сообщения всех новых коммитов (tools/check_publish.mjs). Нашлось — отправка отменяется
z=0000000000000000000000000000000000000000
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then base=$(git merge-base "$lsha" origin/main 2>/dev/null) || base=$lsha; else base=$rsha; fi
  node tools/check_publish.mjs --push "$base..$lsha" || exit 1
done
exit 0
